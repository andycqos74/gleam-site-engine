# Image tag published by GitHub Actions. Use the branch tag until the code is merged to the default branch,
# then "latest" (or sha-<commit> to pin an exact build).
APP_TAG=claude-practical-babbage-9wnzx1

# Which design and content model this site runs: a theme folder in the image (qos, starter) or one mounted at
# /app/themes/<name> (see the volumes section of the stack).
THEME=qos

# Public address of the site, matching the tunnel's public hostname. No trailing slash.
BASE_URL=https://www.example.org.uk

# First administrator, created on first start if no accounts exist yet (at least 10 characters).
# Sign in at <BASE_URL>/admin, then add other editors under Admin > People.
# Don't put a $ in the password (Docker Compose treats it as a variable and cuts the password short), and no quotes.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_admin_password
# Locked out? Set to true and redeploy: the ADMIN_EMAIL account's password is set back to ADMIN_PASSWORD.
# Set it back to false once you've signed in.
ADMIN_RESET=false

# Cloudflare Tunnel: Zero Trust > Networks > Tunnels > create tunnel (Docker) and copy the token.
# Add a public hostname for the tunnel with service http://web:8080
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_tunnel_token
CLOUDFLARED_TAG=latest

# Contact form: messages are always kept under Admin > Messages. Fill in SMTP to also email them.
# (SocketLabs, Microsoft 365, Gmail etc. all offer SMTP.)
CONTACT_TO=community@qosfc.com
MAIL_FROM=website@example.org.uk
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Sign-in cookies only over HTTPS. Set to false only if testing over plain http.
COOKIE_SECURE=true
