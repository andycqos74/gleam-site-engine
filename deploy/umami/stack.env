# Umami image tag. "3" follows Umami 3.x updates (Pull and redeploy to update); pin e.g. 3.4.1 for an exact version.
UMAMI_TAG=3

# Database password, used only between Umami and its database (letters and digits; no $ or quotes).
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_database_password

# Secret for signing Umami's sign-in tokens. Generate with: openssl rand -hex 32
# Changing it later signs everyone out (Gleam sites sign in again by themselves).
APP_SECRET=CHANGE_ME_app_secret

# Only if someone will use two-factor sign-in in Umami: 64 hex characters, from openssl rand -hex 32
TWO_FACTOR_ENCRYPTION_KEY=

# Optional: a different file name for the tracker, e.g. stats.js (then UMAMI_SCRIPT_NAME=stats.js on each Gleam site).
TRACKER_SCRIPT_NAME=

# Cloudflare Tunnel: Zero Trust > Networks > Tunnels > create tunnel (Docker) and copy the token.
# Add a public hostname for the tunnel (e.g. stats.example.org) with service http://umami:3000
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_tunnel_token
CLOUDFLARED_TAG=latest
POSTGRES_TAG=16-alpine
