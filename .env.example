# Copy to .env for `docker compose up`. In Portainer use deploy/portainer/stack.env instead.

# Theme (design + content model): qos or starter, or a folder you add under themes/
THEME=qos

# First administrator, created on first start if no accounts exist yet (at least 10 characters).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_admin_password
# true = set the ADMIN_EMAIL account's password back to ADMIN_PASSWORD on start (if locked out)
ADMIN_RESET=false

# Public address of the site (used for the sitemap, canonical links and social previews). No trailing slash.
BASE_URL=http://localhost:8080

# Contact form: messages are always kept under Admin > Messages. Fill these in to also email them.
CONTACT_TO=community@qosfc.com
MAIL_FROM=website@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Leave blank: sign-in cookies are marked Secure automatically when the site is reached over HTTPS.
COOKIE_SECURE=

# Visitor chat assistant (an AI chat popup on every page that answers questions about the site, using Claude).
# Off unless an Anthropic API key is set. Then an administrator turns it on, names it and writes its instructions
# under Admin > Chat assistant; those settings are kept per site. Model defaults to claude-opus-5-5; effort is
# low, medium, high, xhigh or max (how hard it thinks per answer).
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=medium
